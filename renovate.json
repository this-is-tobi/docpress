{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Group non-major updates into a single PR to keep review cheap",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Majors stay separate, they need a deliberate look",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "typescript-eslint does not support TS 7 yet, see typescript-eslint#10940",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Overrides pin patched versions of transitive dependencies, their major has to stay the one the dependents require",
      "matchDepTypes": ["overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep the bun pin in package.json, mise.toml and the workflows in one PR",
      "matchPackageNames": ["bun", "oven-sh/bun"],
      "groupName": "bun"
    }
  ]
}
