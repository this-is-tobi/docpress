{
  "name": "@tobi-or-not/docpress",
  "type": "module",
  "version": "0.13.0",
  "packageManager": "bun@1.4.2",
  "homepage": "https://this-is-tobi.com/docpress/introduction",
  "repository": {
    "type": "git",
    "url": "https://github.com/this-is-tobi/docpress.git"
  },
  "bin": {
    "docpress": "bin/docpress.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:types && bun run build:vite",
    "build:clean": "node -e \"for (const p of ['./dist','./types','./tsconfig.tsbuildinfo']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "build:docker": "docker build --tag tobi-or-not/docpress --target prod .",
    "build:types": "tsc",
    "build:vite": "vite build",
    "dev": "NODE_ENV=development bun ./dev/docpress.ts",
    "dev:clean": "node -e \"require('node:fs').rmSync('./docpress',{recursive:true,force:true})\" && bun run dev",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "prepare": "husky || true",
    "start": "./bin/docpress.js",
    "start:docker": "docker run --name docpress --rm -v $(pwd)/docpress:/app/docpress:rw tobi-or-not/docpress",
    "stop:docker": "docker rm --force docpress",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.spec.json",
    "vp:build": "vitepress build ./docpress",
    "vp:build:docker": "docker build --tag tobi-or-not/docs --target prod .",
    "vp:dev": "vitepress dev ./docpress --port 8080",
    "vp:dev:docker": "docker run --publish 8080:8080 --name docpress-vp --rm tobi-or-not/docs",
    "vp:preview": "vitepress preview ./docpress --port 8080"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "mermaid": "^12.0.0",
    "picocolors": "^1.1.1",
    "simple-git": "^4.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@octokit/types": "^18.0.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "dompurify": "^3.4.16",
    "fast-uri": "^3.1.8",
    "js-yaml": "^4.3.2",
    "lodash-es": "^4.18.1",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.28"
  }
}
